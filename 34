import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

# Input dataset
data = {
    "Engine": [1.2, 1.5, 1.8, 2.0, 2.2, 2.5],
    "Horsepower": [80, 100, 120, 140, 160, 180],
    "Mileage": [20, 18, 16, 14, 12, 10],
    "Price": [500000, 650000, 800000, 1000000, 1200000, 1400000]
}

df = pd.DataFrame(data)

# Features and target
X = df[["Engine", "Horsepower", "Mileage"]]
y = df["Price"]

# Model
model = LinearRegression()
model.fit(X, y)

# Prediction
y_pred = model.predict(X)

# Evaluation
mse = mean_squared_error(y, y_pred)
r2 = r2_score(y, y_pred)

print("Mean Squared Error:", round(mse, 2))
print("R2 Score:", round(r2, 2))

# Coefficients
print("\nFeature Coefficients:")
for feature, coefficient in zip(X.columns, model.coef_):
    print(feature, ":", round(coefficient, 2))
