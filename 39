import pandas as pd
from sklearn.cluster import KMeans

# Input dataset
data = {
    "Customer_ID": [1, 2, 3, 4, 5, 6, 7, 8],
    "Amount_Spent": [500, 700, 900, 3000, 3500, 4000, 7000, 7500],
    "Visits": [2, 3, 4, 15, 18, 20, 35, 40]
}

df = pd.DataFrame(data)

# Features
X = df[["Amount_Spent", "Visits"]]

# K-Means
model = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

df["Segment"] = model.fit_predict(X)

print("Customer Segments:")
print(df)
