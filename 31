import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

# Input dataset
data = {
    "Age": [22, 25, 28, 30, 35, 40, 45, 50, 26, 32],
    "BP": [110, 120, 125, 130, 135, 140, 145, 150, 122, 132],
    "Cholesterol": [180, 190, 200, 210, 220, 230, 240, 250, 195, 215],
    "Outcome": ["Good", "Good", "Good", "Bad", "Good",
                "Bad", "Bad", "Bad", "Good", "Bad"]
}

df = pd.DataFrame(data)

# Features and target
X = df[["Age", "BP", "Cholesterol"]]
y = df["Outcome"]

# Split data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# KNN model
model = KNeighborsClassifier(n_neighbors=3)
model.fit(X_train, y_train)

# Prediction
y_pred = model.predict(X_test)

# Evaluation
print("Predictions:", list(y_pred))
print("Actual:", list(y_test))

print("\nAccuracy:", round(accuracy_score(y_test, y_pred), 2))
print("Precision:", round(precision_score(
    y_test, y_pred, pos_label="Good", zero_division=0), 2))
print("Recall:", round(recall_score(
    y_test, y_pred, pos_label="Good", zero_division=0), 2))
print("F1 Score:", round(f1_score(
    y_test, y_pred, pos_label="Good", zero_division=0), 2))
