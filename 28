import pandas as pd
from sklearn.tree import DecisionTreeRegressor

# Input dataset
data = {
    "Mileage": [20000, 30000, 40000, 50000, 60000, 70000],
    "Age": [2, 3, 4, 5, 6, 7],
    "Price": [800000, 700000, 600000, 500000, 400000, 300000]
}

df = pd.DataFrame(data)

X = df[["Mileage", "Age"]]
y = df["Price"]

# Train CART model
model = DecisionTreeRegressor(random_state=42)
model.fit(X, y)

# New car input
mileage = 35000
age = 3

new_car = [[mileage, age]]

# Prediction
prediction = model.predict(new_car)

print("New Car:")
print("Mileage:", mileage)
print("Age:", age)

print("\nPredicted Price:", round(prediction[0], 2))
