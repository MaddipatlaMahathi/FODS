import pandas as pd
from sklearn.linear_model import LinearRegression

# Input dataset
data = {
    "Area": [1000, 1200, 1500, 1800, 2000, 2200],
    "Bedrooms": [2, 2, 3, 3, 4, 4],
    "Price": [3000000, 3500000, 4500000, 5200000, 6000000, 6800000]
}

df = pd.DataFrame(data)

# Features and target
X = df[["Area", "Bedrooms"]]
y = df["Price"]

# Create and train model
model = LinearRegression()
model.fit(X, y)

# New house input
area = 1600
bedrooms = 3

new_house = [[area, bedrooms]]

# Prediction
prediction = model.predict(new_house)

print("New House:")
print("Area:", area)
print("Bedrooms:", bedrooms)

print("\nPredicted Price:", round(prediction[0], 2))
